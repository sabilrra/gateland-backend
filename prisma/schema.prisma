generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    Int         @id @default(autoincrement())
  name                  String
  email                 String      @unique
  whatsapp              String?
  address               String?
  password              String
  role                  Role        @default(USER)
  isVerified            Boolean     @default(true) @map("is_verified")
  nik                   String?
  birthPlaceDate        String?     @map("birth_place_date")
  residencyStatus       String?     @map("residency_status")
  familyCount           String?     @map("family_count")
  emergencyContactName  String?     @map("emergency_contact_name")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  rwArea                String?     @map("rw_area")
  occupancyStatus       String?     @map("occupancy_status")
  ownershipType         String?     @map("ownership_type")
  powerWater            String?     @map("power_water")
  vehicles              String?     @db.Text
  photoUrl              String?     @db.LongText @map("photo_url")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  accessLogs            AccessLog[]

  @@map("users")
}

model Gate {
  id         Int         @id @default(autoincrement())
  name       String
  location   String
  status     GateStatus  @default(CLOSED)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  accessLogs AccessLog[]

  @@map("gates")
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  gateId    Int      @map("gate_id")
  action    Action
  timestamp DateTime @default(now())
  gate      Gate     @relation(fields: [gateId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([gateId], map: "access_logs_gate_id_fkey")
  @@index([userId], map: "access_logs_user_id_fkey")
  @@map("access_logs")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  urgency     String   @default("biasa")
  content     String   @db.Text
  location    String?
  eventDate   String?  @map("event_date")
  eventTime   String?  @map("event_time")
  targetWarga String?  @map("target_warga")
  authorName  String?  @default("Admin") @map("author_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model Bill {
  id           Int           @id @default(autoincrement())
  userId       Int?          @map("user_id")
  residentName String        @map("resident_name")
  unit         String
  month        String        @default("Agustus 2026")
  description  String?       @db.Text
  amount       Int           @default(175000)
  status       BillStatus    @default(UNPAID)
  dueDate      String?       @default("10 Agustus 2026") @map("due_date")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]

  @@map("bills")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  channel   String   @default("email")
  target    String?
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model Transaction {
  id             String            @id @default(uuid())
  billId         Int?              @map("bill_id")
  userId         Int?              @map("user_id")
  residentName   String            @map("resident_name")
  unit           String
  amount         Int
  paymentChannel String            @default("QRIS") @map("payment_channel")
  status         TransactionStatus @default(PENDING)
  qrisData       String?           @db.Text @map("qris_data")
  proofUrl       String?           @map("proof_url")
  paidAt         DateTime?         @map("paid_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  bill           Bill?             @relation(fields: [billId], references: [id])

  @@index([billId], map: "transactions_bill_id_fkey")
  @@map("transactions")
}

enum BillStatus {
  UNPAID
  PAID
}

enum TransactionStatus {
  PENDING
  SETTLEMENT
  FAILED
  EXPIRED
}

enum Role {
  ADMIN
  USER
  GUARD
}

enum GateStatus {
  OPEN
  CLOSED
  MAINTENANCE
}

enum Action {
  OPEN
  CLOSE
  DENIED
}
